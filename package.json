{
  "name": "svelte-eslint-parser",
  "version": "1.13.0",
  "type": "module",
  "description": "Svelte parser for ESLint",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sveltejs/svelte-eslint-parser.git"
  },
  "homepage": "https://github.com/sveltejs/svelte-eslint-parser#readme",
  "author": "Yosuke Ota (https://github.com/ota-meshi)",
  "contributors": [
    "JounQin (https://github.com/JounQin)"
  ],
  "funding": "https://github.com/sponsors/ota-meshi",
  "license": "MIT",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0",
    "pnpm": "12.23.0"
  },
  "main": "lib/index.js",
  "files": [
    "lib"
  ],
  "keywords": [
    "svelte",
    "sveltejs",
    "eslint",
    "parser"
  ],
  "scripts": {
    "benchmark": "pnpm run ts benchmark/index.ts",
    "prebuild": "pnpm run clean",
    "build": "pnpm run build:meta && pnpm run build:tsc",
    "build:meta": "pnpm run ts ./tools/update-meta.ts",
    "build:tsc": "tsc --project ./tsconfig.build.json",
    "clean": "node -e \"for (const d of ['lib', 'coverage']) require('node:fs').rmSync(d, { recursive: true, force: true })\"",
    "cover": "c8 --reporter=lcov pnpm run test",
    "debug": "pnpm run ts --test --test-reporter dot \"tests/src/**/*.ts\"",
    "eslint-fix": "pnpm run lint --fix",
    "knip": "knip --dependencies",
    "lint": "eslint . --concurrency auto",
    "prerelease": "pnpm run clean && pnpm run build",
    "release": "changeset publish",
    "run-update-fixtures": "pnpm run ts ./tools/update-fixtures.ts",
    "test": "pnpm run ts --test --test-reporter dot \"tests/src/**/*.ts\"",
    "ts": "node --import tsx/esm",
    "update-fixtures": "git add package.json && pnpm i -D svelte@4 && pnpm run run-update-fixtures && git checkout package.json pnpm-lock.yaml && pnpm i --frozen-lockfile && pnpm run run-update-fixtures",
    "preversion": "pnpm run lint && pnpm run test",
    "version:ci": "IN_VERSION_CI_SCRIPT=true pnpm run build:meta && changeset version"
  },
  "peerDependencies": {
    "@typescript-eslint/parser": "^8.56.0",
    "eslint": "^10.0.0",
    "svelte": "^3.37.0 || ^4.0.0 || ^5.0.0",
    "typescript": ">=4.8.4 <6.1.0"
  },
  "peerDependenciesMeta": {
    "@typescript-eslint/parser": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "dependencies": {
    "eslint-scope": "^9.1.2",
    "eslint-visitor-keys": "^5.0.1",
    "espree": "^11.2.0",
    "postcss": "^8.5.34",
    "postcss-scss": "^4.0.9",
    "postcss-selector-parser": "^7.2.1",
    "semver": "^7.8.6"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@changesets/get-release-plan": "^5.0.2",
    "@e18e/eslint-plugin": "^0.8.1",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@ota-meshi/eslint-plugin": "^0.21.0",
    "@types/benchmark": "^2.1.5",
    "@types/estree": "^1.0.11",
    "@types/node": "^26.6.11",
    "@types/semver": "^7.8.0",
    "@typescript-eslint/parser": "^8.74.0",
    "@typescript-eslint/scope-manager": "^8.74.0",
    "@typescript-eslint/types": "^8.74.0",
    "@typescript-eslint/visitor-keys": "^8.74.0",
    "benchmark": "^2.1.4",
    "c8": "^12.0.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.9",
    "eslint-plugin-jsdoc": "^65.5.7",
    "eslint-plugin-json-schema-validator": "^6.3.2",
    "eslint-plugin-jsonc": "^3.4.2",
    "eslint-plugin-n": "^18.6.0",
    "eslint-plugin-node-dependencies": "^2.4.0",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-regexp": "^3.3.3",
    "eslint-plugin-svelte": "^3.24.1",
    "eslint-plugin-yml": "^3.10.1",
    "globals": "^17.14.0",
    "knip": "^6.48.0",
    "prettier": "^3.10.1",
    "prettier-plugin-pkg": "^0.22.1",
    "prettier-plugin-svelte": "^4.2.0",
    "svelte": "^5.59.2",
    "svelte2tsx": "^0.7.63",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "typescript-eslint-parser-for-extra-files": "^0.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
